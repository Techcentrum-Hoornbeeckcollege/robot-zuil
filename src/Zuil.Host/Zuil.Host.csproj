<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>zuil</AssemblyName>
    <RootNamespace>Zuil.Host</RootNamespace>

    <!-- One self-contained file. IncludeNativeLibrariesForSelfExtract is what
         pulls SQLite's native library inside instead of leaving it beside the
         binary. Trimming is deliberately OFF: get it working first, then try
         PublishTrimmed and test hard, because reflection breakage shows up at
         runtime on a wall-mounted kiosk. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier>$(TargetRid)</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- The frontend is compiled in as embedded resources rather than published
         as loose files, which is what keeps the deliverable a single binary. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Zuil.Core/Zuil.Core.csproj" />
    <ProjectReference Include="../Zuil.Graph/Zuil.Graph.csproj" />
    <ProjectReference Include="../Zuil.Storage/Zuil.Storage.csproj" />
    <ProjectReference Include="../Zuil.Device/Zuil.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Populated by build/build.sh from frontend/dist before publish. -->
    <EmbeddedResource Include="wwwroot/**/*" Exclude="wwwroot/.gitkeep" />
    <Content Remove="wwwroot/**/*" />
  </ItemGroup>

</Project>
