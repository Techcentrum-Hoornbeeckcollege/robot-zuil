{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "Storage": {
    "DatabasePath": "zuil-cache.db",
    "RetainPastMeetingsFor": "02:00:00"
  },
  "Sync": {
    "Interval": "00:03:00",
    "WindowBehind": "02:00:00",
    "WindowAhead": "36:00:00",
    "StaleAfter": "00:15:00"
  },
  "Device": {
    "BusId": 1,
    "Address": 66,
    "AttentionPin": 17,
    "ResponseDelay": "00:00:00.005",
    "MaxRetries": 3,
    "MaxCommandsPerSecond": 10
  },
  "Kiosk": {
    "LaunchBrowser": false,
    "BrowserPath": "chromium-browser",
    "Url": "http://localhost:5000"
  }
}
