[Unit]
Description=Robot Zuil wayfinding kiosk backend
# The app tolerates starting with no network (it serves its cache and retries),
# but waiting avoids a guaranteed first-sync failure in the log.
After=network-online.target
Wants=network-online.target

[Service]
# Type=exec, not notify: notify would require the app to signal readiness via
# the Microsoft.Extensions.Hosting.Systemd package. The kiosk unit waits on
# /api/health instead, which is a truer readiness check anyway.
Type=exec
User=zuil
# i2c access needs group membership, not root. Add the zuil user to i2c and gpio
# rather than running a network-facing service as root.
SupplementaryGroups=i2c gpio
WorkingDirectory=/opt/zuil

# The binary is NOT at /opt/zuil/zuil. scripts/installzuil.sh stages each build
# into /opt/zuil/releases/<timestamp>/ and repoints the `current` symlink, so
# that a bad update is one `ln -sfn` away from being rolled back.
ExecStart=/opt/zuil/current/zuil
Restart=always
RestartSec=5
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production

# Creates and owns /var/lib/zuil, which is where the database and its key file
# live. There is no configuration file and no environment file: everything an
# operator sets is in that database, edited from the kiosk's own screen.
StateDirectory=zuil
StateDirectoryMode=0700

# The single-file binary extracts its native libraries here on first run; give
# it a writable, predictable location instead of /tmp.
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/cache/zuil/extract

# Hardening. StateDirectory above already grants /var/lib/zuil; ReadWritePaths
# covers the single-file extraction directory.
#
# Note ProtectHome=true: it makes ~/.aspnet/DataProtection-Keys unwritable,
# which is why the Graph secret is encrypted with an explicit key file and admin
# sessions are in-process rather than Data Protection cookies. Both would have
# silently fallen back to ephemeral keys here.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/cache/zuil

# Reliable file logging for diagnostic fallback
StandardOutput=append:/var/cache/zuil/backend.log
StandardError=append:/var/cache/zuil/backend.log

[Install]
WantedBy=multi-user.target
